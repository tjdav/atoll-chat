  "query": "\n        SELECT r.id as `id!`, r.name as `name!`, r.level as `level!`, r.permissions as `permissions!`\n        FROM roles r\n        JOIN user_roles ur ON r.id = ur.role_id\n        WHERE ur.user_id = ?\n        ORDER BY r.level DESC\n        ",
