{
  "name": "atoll-chat",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "version": "0.2.13",
  "keywords": [
    "chat",
    "real-time",
    "messaging",
    "coralite",
    "pocketbase",
    "static-site",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "git@codeberg.org/tjdavid/atoll-chat.git"
  },
  "author": {
    "name": "Thomas David",
    "url": "https://thomasjackdavid.com"
  },
  "scripts": {
    "start": "node scripts/start-dev.js",
    "start:app": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --experimental-import-meta-resolve\" coralite-scripts dev",
    "test:server": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --experimental-import-meta-resolve\" coralite-scripts test",
    "build": "coralite-scripts build",
    "lint:types": "pnpm exec tsc --noEmit",
    "lint:format": "eslint --cache --fix .",
    "test:unit": "node --experimental-vm-modules --test",
    "test:unit:coverage": "node --experimental-vm-modules --experimental-test-coverage --test",
    "test:e2e": "node scripts/generate-test-video.js && pnpm exec playwright test",
    "test:e2e:ui": "node scripts/generate-test-video.js && pnpm exec playwright test --ui",
    "test:components": "coralite validate-components --coverage",
    "test:plugins": "coralite validate-plugins --coverage"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@types/node": "^26.1.0",
    "coralite": "^0.43.3",
    "coralite-scripts": "^0.43.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.2",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-jsdoc": "^62.8.1",
    "sirv-cli": "^3.0.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/network": "^8.0.1",
    "@solar-icons/js": "2.0.0-beta.2",
    "altcha": "3.2.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "dexie": "^4.4.3",
    "emoji-picker-element": "^1.29.1",
    "fuse.js": "^7.4.2",
    "idb": "^8.0.3",
    "isomorphic-dompurify": "^3.0.0",
    "libsodium-sumo": "^0.8.4",
    "libsodium-wrappers-sumo": "0.8.3",
    "marked": "^17.0.4",
    "mediabunny": "^1.50.6",
    "otplib": "^13.4.1",
    "pocketbase": "^0.27.0",
    "qrcode": "^1.5.4",
    "turndown": "^7.2.2",
    "zxcvbn": "^4.4.2"
  },
  "packageManager": "pnpm@11.15.0+sha512.266f8957a30d2be6e9468e5e66bcdedd35a794175f71b067ba8504d686cce1d0c0f429b33c323c3c569ad4891e667574a49ff71d1b89a22cc66f13c65818c578"
}