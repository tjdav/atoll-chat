{
  "name": "atoll-chat",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "version": "0.2.9",
  "keywords": [
    "chat",
    "real-time",
    "messaging",
    "coralite",
    "pocketbase",
    "static-site",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "git@codeberg.org/tjdavid/atoll-chat.git"
  },
  "author": {
    "name": "Thomas David",
    "url": "https://thomasjackdavid.com"
  },
  "scripts": {
    "start": "node scripts/start-dev.js",
    "start:app": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --experimental-import-meta-resolve\" coralite-scripts dev",
    "test:app": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --experimental-import-meta-resolve\" coralite-scripts test",
    "build": "coralite-scripts build",
    "lint:types": "pnpm exec tsc --noEmit",
    "lint:format": "eslint --cache --fix .",
    "test:unit": "node --experimental-vm-modules --test",
    "test:unit:coverage": "node --experimental-vm-modules --experimental-test-coverage --test",
    "test:e2e": "node scripts/generate-test-video.js && pnpm exec playwright test",
    "test:e2e:ui": "node scripts/generate-test-video.js && pnpm exec playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@types/node": "^26.1.0",
    "coralite": "^0.43.1",
    "coralite-scripts": "^0.43.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.2",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-jsdoc": "^62.8.1",
    "sirv-cli": "^3.0.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/network": "^8.0.1",
    "bootstrap": "^5.3.8",
    "dexie": "^4.4.3",
    "emoji-picker-element": "^1.29.1",
    "fuse.js": "^7.4.2",
    "idb": "^8.0.3",
    "isomorphic-dompurify": "^3.0.0",
    "libsodium-sumo": "^0.8.4",
    "libsodium-wrappers-sumo": "0.8.3",
    "marked": "^17.0.4",
    "mediabunny": "^1.50.6",
    "otplib": "^13.4.1",
    "pocketbase": "^0.27.0",
    "qrcode": "^1.5.4",
    "turndown": "^7.2.2",
    "zxcvbn": "^4.4.2"
  },
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25"
}
