{
  "name": "atoll-chat",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "version": "0.1.0",
  "keywords": [
    "chat",
    "real-time",
    "messaging",
    "coralite",
    "pocketbase",
    "static-site",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "git@codeberg.org/tjdavid/atoll-chat.git"
  },
  "author": {
    "name": "Thomas David",
    "url": "https://thomasjackdavid.com"
  },
  "scripts": {
    "start": "node scripts/start-dev.js",
    "start:app": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --experimental-import-meta-resolve\" coralite-scripts dev",
    "test:app": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --experimental-import-meta-resolve\" coralite-scripts test",
    "start:database": "docker-compose up -d",
    "build": "coralite-scripts build",
    "lint:types": "pnpm exec tsc --noEmit",
    "lint:format": "eslint --cache --fix .",
    "test:unit": "node --experimental-vm-modules --test",
    "test:unit:coverage": "node --experimental-vm-modules --experimental-test-coverage --test",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:ui": "pnpm exec playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@stylistic/eslint-plugin": "^5.9.0",
    "coralite": "^0.41.0",
    "coralite-scripts": "^0.41.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.2",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-jsdoc": "^62.8.1",
    "sirv-cli": "^3.0.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "dexie": "^4.4.3",
    "emoji-picker-element": "^1.29.1",
    "fuse.js": "^7.4.2",
    "idb": "^8.0.3",
    "isomorphic-dompurify": "^3.0.0",
    "libsodium-sumo": "^0.8.4",
    "libsodium-wrappers-sumo": "0.8.3",
    "marked": "^17.0.4",
    "mediabunny": "^1.50.6",
    "music-metadata": "^11.13.0",
    "pocketbase": "^0.27.0",
    "turndown": "^7.2.2",
    "zxcvbn": "^4.4.2"
  }
}