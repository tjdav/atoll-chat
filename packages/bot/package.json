{
  "name": "@atoll/bot",
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "main": "./src/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "atoll-bot": "./src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./src/testing/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test:canary": "tsc --noEmit",
    "check-batches": "node tests/manifest-check.js",
    "test:batch": "node tests/manifest-check.js --batch",
    "test:all": "node tests/run-all-batches.js",
    "test": "pnpm test:canary && pnpm check-batches && pnpm test:all",
    "lint": "eslint .",
    "validate": "pnpm lint && pnpm test && pnpm build"
  }
}
