{
  "openapi": "3.1.0",
  "info": {
    "title": "Atoll Encrypted Chat API",
    "description": "OpenAPI specification for the Atoll server API. Derived from code annotations. Source of truth remains Server Spec v3.0.4.",
    "license": {
      "name": ""
    },
    "version": "3.0.4"
  },
  "paths": {
    "/api/v1/capabilities": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Feature advertisement",
        "description": "Server capabilities and configuration advertisement endpoint (Server Spec v3.0.4 §8.1).",
        "operationId": "handler",
        "responses": {
          "200": {
            "description": "Capabilities retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Health check",
        "description": "Server liveness check endpoint (Server Spec v3.0.4 §8.1).",
        "operationId": "handler",
        "responses": {
          "200": {
            "description": "Server is live",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ready": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Readiness check",
        "description": "Server readiness check endpoint verifying DB, OPRF key, and Sockudo (Server Spec v3.0.4 §8.1).",
        "operationId": "handler",
        "responses": {
          "200": {
            "description": "Server is ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "530": {
            "description": "Server is not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "Current user profile",
        "description": "Fetches the current authenticated user's profile and limits (Server Spec v3.0.4 §8.2, §8.2.1).",
        "operationId": "get_me",
        "responses": {
          "200": {
            "description": "User profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    }
  },
